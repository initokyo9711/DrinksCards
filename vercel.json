{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1"
        },
        "api/test.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "VIEW_COMPILED_PATH": "/tmp/views"
    },
    "routes": [
        {
            "src": "/test",
            "dest": "api/test.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "public/build/$1"
        },
        {
            "src": "/(css|js|images|fonts|build)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/favicon.ico",
            "dest": "public/favicon.ico"
        },
        {
            "src": "/DrinksCardDesign.png",
            "dest": "public/DrinksCardDesign.png"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}
