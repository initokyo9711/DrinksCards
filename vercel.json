{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.1"
        },
        "api/test.php": {
            "runtime": "vercel-php@0.7.1"
        }
    },
    "env": {
        "SESSION_DRIVER": "file",
        "SESSION_PATH": "/tmp/sessions",
        "CACHE_STORE": "file",
        "APP_CONFIG_CACHE": "/tmp/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/cache/routes.php",
        "VIEW_COMPILED_PATH": "/tmp/views"
    },
    "routes": [
        {
            "src": "/test",
            "dest": "api/test.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "public/build/$1"
        },
        {
            "src": "/(css|js|images|fonts|build)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/favicon.ico",
            "dest": "public/favicon.ico"
        },
        {
            "src": "/DrinksCardDesign.png",
            "dest": "public/DrinksCardDesign.png"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}
